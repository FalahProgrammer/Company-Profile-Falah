# Base URL of the CMS (company-profile-falah-cms). Server-side only.
# Leave empty for an offline build (CI): pages are then rendered on demand.
CMS_URL=http://localhost:3001

# Bucket / CDN base URL of CMS media when S3/R2 storage is enabled
# (MinIO: http://localhost:9000/falah-media). /media/* on this site is proxied here.
CMS_MEDIA_URL=

# Must equal REVALIDATE_SECRET in the CMS .env (openssl rand -hex 32)
REVALIDATE_SECRET=

# Must equal CONTACT_API_KEY in the CMS .env (openssl rand -hex 32)
CMS_CONTACT_API_KEY=

# Public address of this website, no trailing slash. Used for the sitemap,
# robots.txt and absolute canonical / preview URLs. Leave empty in development.
SITE_URL=

# Google Search Console, "HTML tag" verification: the value of the tag's
# content="…" (only the token). Optional.
GOOGLE_SITE_VERIFICATION=
